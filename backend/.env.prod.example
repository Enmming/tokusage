POSTGRES_USER=tokusage
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=tokusage

# Published by .github/workflows/backend-image.yml.
TOKUSAGE_BACKEND_IMAGE=ghcr.io/enmming/tokusage-backend:latest
TOKUSAGE_API_PORT=8080
TOKUSAGE_MAX_REQUEST_BYTES=8388608

# WeCom portal login (self-built app in the WeCom admin console).
TOKUSAGE_WECOM_CORP_ID=
TOKUSAGE_WECOM_AGENT_ID=
TOKUSAGE_WECOM_CORP_SECRET=
# Must match the trusted callback domain configured in the WeCom admin console.
TOKUSAGE_WECOM_REDIRECT_URI=https://your-domain.example/api/auth/wecom/callback

# Portal session signing key. Generate with: openssl rand -hex 32
TOKUSAGE_PORTAL_SESSION_SECRET=replace-with-a-random-secret
# Keep true behind HTTPS; set false only for plain-HTTP testing.
TOKUSAGE_PORTAL_COOKIE_SECURE=true
